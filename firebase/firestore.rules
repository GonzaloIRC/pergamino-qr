rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthed() { return request.auth != null; }

    // Ajustes: lectura solo autenticada, escritura denegada por ahora
    match /Ajustes/{doc} {
      allow read: if isAuthed();
      allow write: if false;
    }

    // Clientes: lectura con autenticación y escritura con DNI único
    // Requiere que el ID de documento coincida con el DNI, que el campo dni del recurso
    // coincida con el parámetro y que se asocie el uid del usuario autenticado.
    match /Clientes/{dni} {
      allow read: if isAuthed();
      allow create: if isAuthed()
        && request.resource.id == dni
        && request.resource.data.dni == dni
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/Clientes/$(dni));
      allow update: if isAuthed()
        && request.resource.data.dni == dni
        && request.resource.data.uid == request.auth.uid;
    }

    // Perfiles: cada usuario puede leer/modificar su propio perfil
    match /Perfiles/{uid} {
      allow read, write: if isAuthed() && uid == request.auth.uid;
    }

    // Beneficios: solo lectura
    match /Beneficios/{id} {
      allow read: if isAuthed();
      allow write: if false;
    }

    // BeneficioSeriales: lectura y escritura autenticada (canje, emision)
    match /BeneficioSeriales/{serial} {
      allow read: if isAuthed();
      allow write: if isAuthed();
    }

    // Historial: lectura y escritura autenticada
    match /Historial/{id} {
      allow read: if isAuthed();
      allow write: if isAuthed();
    }

    // Por defecto denegar
    match /{document=**} {
      allow read, write: if false;
    }
  }
}