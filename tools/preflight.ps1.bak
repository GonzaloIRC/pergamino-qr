<#
.SYNOPSIS
    Script de verificación rápida del entorno y proyecto.

.DESCRIPTION
    Realiza una serie de verificaciones para asegurar que el entorno
    de desarrollo está correctamente configurado y que el proyecto
    puede compilarse sin errores.

.PARAMETER WithE2E
    Ejecuta pruebas E2E después de las verificaciones básicas.

.PARAMETER NoEmulators
    Omite el inicio de emuladores de Firebase para pruebas locales.

.EXAMPLE
    .\preflight.ps1
    Ejecuta verificaciones básicas del entorno sin pruebas E2E, con emuladores.

.EXAMPLE
    .\preflight.ps1 -WithE2E
    Ejecuta verificaciones básicas y añade pruebas E2E, con emuladores.

.EXAMPLE
    .\preflight.ps1 -NoEmulators
    Ejecuta verificaciones básicas sin iniciar emuladores de Firebase.
#>

Param(
  [switch]$WithE2E,
  [switch]$NoEmulators
)

# Invertimos la lógica para evitar el switch con valor true por defecto
$UseEmulators = -not $NoEmulators

Write-Host "== Preflight: entorno y proyecto ==" -ForegroundColor Cyan

# 1) Node/NPM
Write-Host ">> Verificando Node.js y npm"
try {
    $nodeVersion = node -v
    $npmVersion = npm -v
    Write-Host "Node: $nodeVersion" -ForegroundColor Green
    Write-Host "NPM: $npmVersion" -ForegroundColor Green
} catch {
    Write-Host "Error: Node.js o npm no disponibles" -ForegroundColor Red
    exit 1
}

# 2) Expo doctor (admin móvil)
Write-Host ">> Ejecutando Expo doctor"
try {
    npx expo doctor
    if ($LASTEXITCODE -ne 0) {
        Write-Host "Error: expo doctor falló" -ForegroundColor Red
        exit 1
    }
} catch {
    Write-Host "Error: No se pudo ejecutar expo doctor" -ForegroundColor Red
    exit 1
}

# 3) Lint + Typecheck (monorepo)
Write-Host ">> Ejecutando Lint"
try {
    npm run -ws lint
    if ($LASTEXITCODE -ne 0) {
        Write-Host "Error: lint falló" -ForegroundColor Red
        exit 1
    }
} catch {
    Write-Host "Error: No se pudo ejecutar lint" -ForegroundColor Red
    exit 1
}

Write-Host ">> Ejecutando Typecheck"
try {
    npm run -ws typecheck
    if ($LASTEXITCODE -ne 0) {
        Write-Host "Error: typecheck falló" -ForegroundColor Red
        exit 1
    }
} catch {
    Write-Host "Error: No se pudo ejecutar typecheck" -ForegroundColor Red
    exit 1
}

# 4) Build admin-web (sin subir nada)
Write-Host ">> Ejecutando Build admin-web"
try {
    npm run --workspace apps/admin-web build
    if ($LASTEXITCODE -ne 0) {
        Write-Host "Error: build admin-web falló" -ForegroundColor Red
        exit 1
    }
} catch {
    Write-Host "Error: No se pudo ejecutar build admin-web" -ForegroundColor Red
    exit 1
}

# 5) Firebase emulators (opcional)
if ($UseEmulators) {
    Write-Host ">> Iniciando Firebase emulators (background)"
    try {
        Start-Process -FilePath "npx" -ArgumentList "firebase emulators:start" -WindowStyle Minimized
        Start-Sleep -Seconds 6
    } catch {
        Write-Host "Error: No se pudieron iniciar los emuladores de Firebase" -ForegroundColor Red
    }
}

# 6) E2E (opcional, serial)
$e2eStatus = "No ejecutado"
if ($WithE2E) {
    Write-Host ">> Ejecutando pruebas E2E (serial, workers=1)"
    try {
        npx playwright install --with-deps
        npx playwright test --workers=1
        
        if ($LASTEXITCODE -ne 0) {
            $e2eStatus = "Fallido"
            Write-Host "❌ Algunas pruebas E2E fallaron. Revisa el reporte para más detalles." -ForegroundColor Red
            Write-Host "   Puedes ver el reporte HTML con: npx playwright show-report" -ForegroundColor Yellow
        } else {
            $e2eStatus = "Exitoso"
            Write-Host "✓ Todas las pruebas E2E pasaron correctamente" -ForegroundColor Green
        }
    } catch {
        $e2eStatus = "Error"
        Write-Host "Error: No se pudieron ejecutar las pruebas E2E" -ForegroundColor Red
    }
}

# Resumen
$currentTime = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
Write-Host ""
Write-Host "== Resumen de preflight ==" -ForegroundColor Cyan
Write-Host "Fecha: $currentTime"
Write-Host "Node: $nodeVersion"
Write-Host "NPM: $npmVersion"
Write-Host "E2E: $e2eStatus"
Write-Host "Emuladores: $(if ($UseEmulators) { "Iniciados" } else { "Omitidos" })"
Write-Host ""
Write-Host "✓ Preflight OK" -ForegroundColor Green
Write-Host "El proyecto está listo para desarrollo/integración." -ForegroundColor Green

# 6) E2E (opcional, serial)
if ($WithE2E) {
  Write-Host ">> E2E (serial, workers=1)"
  npx playwright install --with-deps
  npx playwright test --workers=1
  
  # Verificar si las pruebas E2E pasaron
  if ($LASTEXITCODE -ne 0) {
    Write-Host "❌ Algunas pruebas E2E fallaron. Revisa el reporte para más detalles." -ForegroundColor Red
    Write-Host "   Puedes ver el reporte HTML con: npx playwright show-report" -ForegroundColor Yellow
  } else {
    Write-Host "✓ Todas las pruebas E2E pasaron correctamente" -ForegroundColor Green
  }
}

# Resumen
$currentTime = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
Write-Host ""
Write-Host "== Resumen de preflight ==" -ForegroundColor Cyan
Write-Host "Fecha: $currentTime"
Write-Host "Node: $(node -v)"
Write-Host "NPM: $(npm -v)"
Write-Host "E2E ejecutado: $WithE2E"
Write-Host "Emuladores utilizados: $UseEmulators (NoEmulators: $NoEmulators)"
Write-Host ""
Write-Host "✓ Preflight OK" -ForegroundColor Green
Write-Host "El proyecto está listo para desarrollo/integración." -ForegroundColor Green