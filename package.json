{
  "name": "pergamino-app",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "engines": {
    "node": "20.x"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-reanimated"
      ]
    }
  },
  "scripts": {
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:smoke": "playwright test -g \"smoke\"",
    "start": "expo start --dev-client",
    "start:clean": "expo start --dev-client --clear",
    "start:dev": "expo start --dev-client --clear",
    "start:staging": "expo start --dev-client --clear --config app.staging.json",
    "start:prod": "expo start --dev-client --clear --config app.production.json",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "web:staging": "cd apps/admin-web && next dev --port 3001 -H 0.0.0.0 --env .env.staging",
    "web:prod": "cd apps/admin-web && next dev --port 3002 -H 0.0.0.0 --env .env.production",
    "prepare-m1": "node scripts/prepare-m1.js",
    "prebuild": "node scripts/prebuild-sync.js",
    "doctor": "expo-doctor",
    "scan": "node SCRIPTS/context-scan-fix.js",
    "emulators:start": "npx --yes firebase-tools@latest emulators:start --project demo-pergamino",
    "rules:deploy": "npx --yes firebase-tools@latest deploy --only firestore:rules",
    "indexes:deploy": "npx --yes firebase-tools@latest deploy --only firestore:indexes",
    "emulators:export": "npx --yes firebase-tools@latest emulators:export ./emulator-data",
    "emulators:import": "npx --yes firebase-tools@latest emulators:import ./emulator-data"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "^2.1.2",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "date-fns": "^4.1.0",
    "expo": "^54.0.10",
    "expo-camera": "~17.0.8",
    "expo-dev-client": "~6.0.12",
    "expo-file-system": "~19.0.15",
    "expo-font": "~14.0.8",
    "expo-location": "~19.0.7",
    "expo-notifications": "^0.32.11",
    "expo-sharing": "~14.0.7",
    "firebase": "^12.2.1",
    "react": "19.1.0",
    "react-csv": "^2.2.2",
    "react-dom": "19.1.0",
    "react-native": "0.81.4",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-paper": "^5.14.5",
    "react-native-qrcode-svg": "^6.3.15",
    "react-native-reanimated": "^3.6.1",
    "react-native-safe-area-context": "^5.4.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.12.1",
    "react-native-web": "^0.21.1",
    "recharts": "^3.2.1"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@playwright/test": "^1.55.1",
    "@testing-library/react-native": "^12.4.3",
    "@types/react": "~19.1.10",
    "@types/react-csv": "^1.1.10",
    "csv-parse": "^5.5.3",
    "dotenv": "^17.2.2",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-native": "^4.1.0",
    "firebase-admin": "^13.5.0",
    "jest": "^29.7.0",
    "metro": "^0.83.2",
    "typescript": "~5.9.2"
  },
  "private": true
}
