{
  "name": "pergamino-app",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "start": "expo start --dev-client",
    "start:clean": "expo start --dev-client --clear",
    "start:dev": "expo start --dev-client --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prepare-m1": "node scripts/prepare-m1.js",
    "prebuild": "node scripts/prebuild-sync.js",
    "doctor": "expo-doctor",
    "scan": "node SCRIPTS/context-scan-fix.js",
    "emulators:start": "npx --yes firebase-tools@latest emulators:start --project demo-pergamino",
    "emulators:export": "npx --yes firebase-tools@latest emulators:export ./emulator-data",
    "emulators:import": "npx --yes firebase-tools@latest emulators:import ./emulator-data"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "^2.1.2",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "expo": "^54.0.10",
    "expo-camera": "~17.0.8",
    "expo-file-system": "~19.0.15",
    "expo-font": "~14.0.8",
    "expo-location": "~19.0.7",
    "expo-notifications": "~0.31.4",
    "expo-sharing": "~14.0.7",
    "firebase": "^12.2.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.5",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-paper": "^5.14.5",
    "react-native-qrcode-svg": "^6.3.15",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "^5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "^15.11.2",
    "react-native-web": "^0.20.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@testing-library/react-native": "^12.4.3",
    "@types/react": "~19.0.10",
    "dotenv": "^17.2.2",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-native": "^4.1.0",
    "firebase-admin": "^13.5.0",
    "jest": "^29.7.0",
    "metro": "^0.82.0",
    "typescript": "~5.8.3"
  },
  "private": true
}
