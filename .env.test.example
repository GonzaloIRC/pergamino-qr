# Test environment variables for E2E tests (EXAMPLE)
# Duplicate this file as .env.test and fill in with appropriate values

E2E_BASE_URL=http://localhost:3000

# Test users
TEST_USER_EMAIL=admin@example.com
TEST_USER_PASSWORD=secure_password
LIMITED_USER_EMAIL=limited@example.com
LIMITED_USER_PASSWORD=secure_password

# Firebase test configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your:app:id